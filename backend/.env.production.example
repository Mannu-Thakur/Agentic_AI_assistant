# ─────────────────────────────────────────────────────────────────────────────
#  .env.production.example — Production environment configuration template
#  Copy to .env and fill in real values before deploying.
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Database (PostgreSQL required in production — SQLite will be REJECTED) ─────
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://ai_user:strongpassword@localhost:5432/ai_workspace_db

# ── Redis (required for cross-worker cache sharing) ────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<replace_with_strong_random_64_char_hex>

# ── Server ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# ── LLM Providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=<your_groq_key>
GEMINI_API_KEY=<your_gemini_key>
OPENROUTER_API_KEY=<your_openrouter_key>
OPENAI_API_KEY=<your_openai_key>

# ── Search Providers ───────────────────────────────────────────────────────────
TAVILY_API_KEY=<your_tavily_key>
SERP_API_KEY=<your_serpapi_key>
EXA_API_KEY=<your_exa_key>
WEB_SEARCH_PROVIDER_ORDER=tavily,serpapi,exa,duckduckgo
WEB_SEARCH_MAX_RESULTS=8

# ── Vector DB ──────────────────────────────────────────────────────────────────
VECTOR_DB_DIR=/app/vector_db

# ── OAuth ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GITHUB_CLIENT_ID=<your_github_client_id>
GITHUB_CLIENT_SECRET=<your_github_client_secret>

# ── CORS ───────────────────────────────────────────────────────────────────────
# Add your production frontend domain
BACKEND_CORS_ORIGINS=["https://yourdomain.com"]

# ── OCR (optional) ─────────────────────────────────────────────────────────────
# Leave blank if OCR is not needed
# TESSERACT_CMD=/usr/bin/tesseract
# REQUIRE_OCR=false

# ─────────────────────────────────────────────────────────────────────────────
#  PostgreSQL Quick Setup (one-time):
#
#  psql -U postgres
#  CREATE DATABASE ai_workspace_db;
#  CREATE USER ai_user WITH ENCRYPTED PASSWORD 'strongpassword';
#  GRANT ALL PRIVILEGES ON DATABASE ai_workspace_db TO ai_user;
#
#  Then run: cd backend && python -m alembic upgrade head
#
#  Or migrate from SQLite:  python migrate_sqlite_to_pg.py
# ─────────────────────────────────────────────────────────────────────────────
