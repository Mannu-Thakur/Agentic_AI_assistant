# ─────────────────────────────────────────────────────────────────────────────
#  .env.template — copy to .env and fill in your values
#  DO NOT commit the .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_assistant
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── LLM Provider API Keys ─────────────────────────────────────────────────────
# Leave blank or prefix with "mock_" to run in mock/offline mode
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Web Search Providers ──────────────────────────────────────────────────────
# Waterfall order: tavily → serpapi → exa → duckduckgo (always free fallback)
# Leave any key blank to skip that provider automatically.
# Sign up: tavily.com | serpapi.com | exa.ai (all have free tiers)
TAVILY_API_KEY=
SERP_API_KEY=
EXA_API_KEY=
WEB_SEARCH_PROVIDER_ORDER=tavily,serpapi,exa,duckduckgo
WEB_SEARCH_MAX_RESULTS=8

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── App ───────────────────────────────────────────────────────────────────────
PROJECT_NAME=Omni Agentic Workspace
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]
BACKEND_PORT=8000
FRONTEND_PORT=80

# ── Environment (development | staging | production) ──────────────────────────
# WARNING: In staging/production the app will EXIT on startup if SECRET_KEY
# is still set to the default insecure value.
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (development/testing):
DATABASE_URL=sqlite:///./sql_app.db
# PostgreSQL (staging/production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_assistant

# ── JWT Hardening ─────────────────────────────────────────────────────────────
JWT_ISSUER=flagship-auth
JWT_AUDIENCE=flagship-app

# ── Whitelisted Redirect URIs (comma-separated, no spaces) ────────────────────
ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/google/callback,http://localhost:5173/auth/github/callback

# ── OCR — Tesseract binary path ───────────────────────────────────────────────
# Leave blank to auto-detect from common install locations.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/Mac example: /usr/bin/tesseract
TESSERACT_CMD=
REQUIRE_OCR=false

# ── Malware Scanning (Optional ClamAV Integration) ───────────────────────────
# Set CLAMAV_HOST to enable background antivirus scanning on all uploads
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ── Email / SMTP Configuration ────────────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASSWORD blank to print reset links to the server console in development mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@openchat.ai
SMTP_FROM_NAME=openChat Workspace
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15


